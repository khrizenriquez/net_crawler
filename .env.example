POSTGRES_DB=duku_net_lab
POSTGRES_USER=duku
POSTGRES_PASSWORD=replace-with-a-local-password
DUKU_HOST_TOKEN=replace-with-a-random-local-token
# Local operational storage. make configure-local-env sets an absolute private path.
DUKU_DATA_DIR=
# Add only explicitly authorized local radios after onboarding.
DUKU_AUTHORIZED_BSSID=
DUKU_DEMO_SEED=true
# Optional Huawei adapter values. Leave unset until the read-only collector is configured.
HUAWEI_BASE_URL=
HUAWEI_USERNAME=
HUAWEI_PASSWORD=
# Optional WPA2 PSKs remain local and must never be committed.
DUKU_WIFI_PSK_24=
DUKU_WIFI_PSK_5=
